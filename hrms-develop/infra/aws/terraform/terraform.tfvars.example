# Copy to terraform.tfvars (which is gitignored) and edit.

domain_name = "hr.yourdomain.co.ke"

# Region: af-south-1 (Cape Town) must be enabled in your AWS account first.
# Use eu-west-1 (Ireland) if you do not want to enable it.
region = "af-south-1"

# Only needed if the GitHub repository is private (read-only fine-grained token).
# Prefer the environment variable instead of writing it here:  export TF_VAR_git_token=...
# git_token = ""

# instance_type  = "t3.large"
# data_volume_gb = 50
