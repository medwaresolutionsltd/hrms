# Example only. On the server, `.env` is generated at first boot from AWS SSM Parameter Store
# and is readable by root only. Never commit a real .env.

SITE_NAME=hr.yourdomain.co.ke
ADMIN_PASSWORD=change-me
DB_ROOT_PASSWORD=change-me
GUNICORN_WORKERS=3

# Used by backup.sh
BACKUP_BUCKET=medware-hr-backups-123456789012
AWS_REGION=af-south-1
